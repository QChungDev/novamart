# Copy sang .env va dien gia tri that. KHONG commit file .env chua key that.

APP_ENV=dev
# Chuoi ket noi database. Dev: sqlite | Production: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./data/app.db

# Khoa bi mat: ky session + ma hoa API key luu trong DB (Fernet). Tao bang: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=change-me-generate-a-real-one

# Thu muc luu media (anh/video/audio upload)
MEDIA_ROOT=./data/media

# Frontend origins cho CORS, cach nhau bang dau phay
CORS_ORIGINS=http://localhost:3000

# Gioi han upload (MB)
MAX_IMAGE_MB=10
MAX_VIDEO_MB=500
MAX_AUDIO_MB=50

# Mac dinh chia canh (Seedance 2.5 ho tro toi 30s/clip)
DEFAULT_SCENE_SECONDS=20

# BytePlus ModelArk (Seedance) - API chinh thuc cho video AI
# Dang ky tai https://www.byteplus.com (quoc te) de lay API key.
# Luu y: domain API quoc te la bytepluses.com (co 's'), da xac minh 17/10/2026.
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=dreamina-seedance-2-5-260628

# Worker nen poll moi N giay
WORKER_POLL_SECONDS=5
